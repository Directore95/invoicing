rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helper functions
    // ============================================================

    // Check if the user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Check if the authenticated user owns this document
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Check that a string field is present and non-empty
    function hasString(field) {
      return field is string && field.size() > 0;
    }

    // Check that a number field is valid (non-negative)
    function isPositiveNumber(field) {
      return field is number && field >= 0;
    }

    // Check that the status is a valid invoice status
    function isValidStatus(status) {
      return status in ['draft', 'sent', 'paid', 'overdue', 'cancelled'];
    }

    // Check that the locale is valid
    function isValidLocale(locale) {
      return locale in ['en', 'sk'];
    }

    // Check that the template is valid
    function isValidTemplate(template) {
      return template in ['modern', 'classic', 'minimal'];
    }

    // Prevent changing the owner (userId) after creation
    function ownerUnchanged() {
      return request.resource.data.userId == resource.data.userId;
    }

    // ============================================================
    // Per-user document: /users/{userId}
    // Stores app settings (locale, invoice prefix, defaults, etc.)
    // ============================================================
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && hasString(request.resource.data.locale)
        && isValidLocale(request.resource.data.locale);
      allow update: if isOwner(userId)
        && isValidLocale(request.resource.data.locale);
      allow delete: if isOwner(userId);
    }

    // ============================================================
    // Companies: /users/{userId}/companies/{companyId}
    // Each user can have multiple companies (multi-company support)
    // ============================================================
    match /users/{userId}/companies/{companyId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && hasString(request.resource.data.name)
        && isValidLocale(request.resource.data.locale)
        && request.resource.data.userId == userId;

      allow update: if isOwner(userId)
        && hasString(request.resource.data.name)
        && isValidLocale(request.resource.data.locale)
        && ownerUnchanged();

      allow delete: if isOwner(userId);
    }

    // ============================================================
    // Partners (Clients / Business Partners):
    //   /users/{userId}/partners/{partnerId}
    // Reusable client profiles that can be selected when creating invoices
    // ============================================================
    match /users/{userId}/partners/{partnerId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && hasString(request.resource.data.name)
        && request.resource.data.userId == userId;

      allow update: if isOwner(userId)
        && hasString(request.resource.data.name)
        && ownerUnchanged();

      allow delete: if isOwner(userId);
    }

    // ============================================================
    // Invoices: /users/{userId}/invoices/{invoiceId}
    // Full invoice documents including line items (stored as array)
    // ============================================================
    match /users/{userId}/invoices/{invoiceId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.userId == userId
        && hasString(request.resource.data.invoiceNumber)
        && hasString(request.resource.data.clientName)
        && hasString(request.resource.data.invoiceDate)
        && hasString(request.resource.data.dueDate)
        && isValidStatus(request.resource.data.status)
        && isValidLocale(request.resource.data.locale)
        && isValidTemplate(request.resource.data.template)
        && isPositiveNumber(request.resource.data.subtotal)
        && isPositiveNumber(request.resource.data.total)
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;

      allow update: if isOwner(userId)
        && ownerUnchanged()
        && hasString(request.resource.data.invoiceNumber)
        && hasString(request.resource.data.clientName)
        && isValidStatus(request.resource.data.status)
        && isValidLocale(request.resource.data.locale)
        && isValidTemplate(request.resource.data.template)
        && isPositiveNumber(request.resource.data.subtotal)
        && isPositiveNumber(request.resource.data.total)
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;

      allow delete: if isOwner(userId);
    }

    // ============================================================
    // Catch-all: deny everything else
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
